[Unit]
Description=Sinty Accounts (accountsservice-compatible)
Documentation=https://github.com/singularityos-lab/sinty-accounts
After=dbus.service

[Service]
Type=dbus
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
BusName=org.freedesktop.Accounts
ExecStart=/usr/libexec/sinty-accountsd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical.target
